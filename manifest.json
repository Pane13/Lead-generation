{
 "name": "Diamondweb Leads",
 "short_name": "DW Leads",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "orientation": "portrait",
 "background_color": "#f1f3fb",
 "theme_color": "#f1f3fb",
 "lang": "it",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  }
 ],
 "share_target": {
  "action": "./share-kp",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "file",
     "accept": [
      "text/csv",
      ".csv",
      "text/tab-separated-values",
      ".tsv",
      "text/plain",
      ".txt",
      "application/vnd.ms-excel"
     ]
    }
   ]
  }
 }
}